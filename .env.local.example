# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — it never gets committed.

# --- Microsoft Graph (sends all outgoing email) ---
# From an Azure AD App Registration with Mail.Send application permission
# (admin consent granted). See the setup steps in the project chat/README.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Mailbox the emails are sent FROM (must exist in your Microsoft 365 tenant).
MS_SENDER_EMAIL=egisupport@4ecomis.com

# --- Where alerts land ---
# Contact-form leads are sent here instantly; the daily traffic digest is
# sent here once every 24 hours. Defaults to the same mailbox as
# MS_SENDER_EMAIL (it can send to itself) — point it elsewhere if you'd
# rather a different inbox receive these.
ALERT_TO_EMAIL=egisupport@4ecomis.com

# --- Daily digest cron ---
# Random secret that authorizes calls to /api/cron/daily-digest?token=...
# Generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Timezone used to format timestamps in the digest email.
REPORT_TIMEZONE=America/Chicago
